# Copy to .env and fill in. Real environment variables win over this file.
# Comments only on their own lines.
GOOP_PROVIDER=anthropic
GOOP_API_KEY=
# GOOP_MODEL=claude-sonnet-5
# GOOP_SYSTEM=You are a terse assistant.

# TypeSafe jev: gates every tool call and is offered to the model as a tool.
# GOOP_JEV_KEY=
# To use a local laya-mlx server instead of the hosted API:
# GOOP_JEV_URL=http://127.0.0.1:8000/v1/predict
# GOOP_JEV_MODEL=

# OpenAI Responses API (first-party; replays reasoning between tool calls).
# GOOP_PROVIDER=responses
# GOOP_MODEL=gpt-5

# OpenAI Chat Completions, or any compatible server (LM Studio, OpenRouter, ...).
# GOOP_PROVIDER=openai
# GOOP_BASE_URL=http://localhost:1234/v1
# GOOP_MODEL=gpt-5
